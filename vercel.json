      "permanent": true
    },
    {
      "source": "/coaching/:path*",
      "destination": "/%ED%95%99%EC%8A%B5%EC%BD%94%EC%B9%AD/:path*",
      "permanent": true
    },
    {
      "source": "/guide",
      "destination": "/%ED%95%99%EC%8A%B5%EA%B0%80%EC%9D%B4%EB%93%9C/",
      "permanent": true
    },
    {
      "source": "/guide/",
      "destination": "/%ED%95%99%EC%8A%B5%EA%B0%80%EC%9D%B4%EB%93%9C/",
      "permanent": true
    },
    {
      "source": "/guide/:path*",
      "destination": "/%ED%95%99%EC%8A%B5%EA%B0%80%EC%9D%B4%EB%93%9C/:path*",
      "permanent": true
    },
    {
      "source": "/center",
      "destination": "/%EC%A0%84%EA%B5%AD%ED%95%99%EC%9B%90/",
      "permanent": true
    },
    {
      "source": "/center/",
      "destination": "/%EC%A0%84%EA%B5%AD%ED%95%99%EC%9B%90/",
      "permanent": true
    },
    {
      "source": "/center/:path*",
      "destination": "/%EC%A0%84%EA%B5%AD%ED%95%99%EC%9B%90/:path*",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/%EC%83%81%EB%8B%B4%EB%AC%B8%EC%9D%98/",
      "permanent": true
    },
    {
      "source": "/contact/",
      "destination": "/%EC%83%81%EB%8B%B4%EB%AC%B8%EC%9D%98/",
      "permanent": true
    },
    {
      "source": "/contact/:path*",
      "destination": "/%EC%83%81%EB%8B%B4%EB%AC%B8%EC%9D%98/:path*",
      "permanent": true
    },
    {
      "source": "/%EC%84%A0%EC%83%9D%EB%8B%98%EC%B0%BE%EA%B8%B0/%EB%8B%A4%EC%82%B0%EC%A0%90\\(W\\+\\)/",
      "destination": "/%EC%84%A0%EC%83%9D%EB%8B%98%EC%B0%BE%EA%B8%B0/%EB%8B%A4%EC%82%B0%EC%A0%90%28W%2B%29/",
      "permanent": true
    },
    {
      "source": "/%EC%84%A0%EC%83%9D%EB%8B%98%EC%B0%BE%EA%B8%B0/%EB%91%94%EC%82%B0%EC%A0%90\\(W\\+\\)/",
      "destination": "/%EC%84%A0%EC%83%9D%EB%8B%98%EC%B0%BE%EA%B8%B0/%EB%91%94%EC%82%B0%EC%A0%90%28W%2B%29/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/crawl-media/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "buildCommand": "node favicon-build.mjs",
  "outputDirectory": ".public-release"
}
